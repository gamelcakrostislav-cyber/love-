# ─── App ────────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=INFO

# ─── Database (PostgreSQL, async driver) ──────────────────────────────────────
# Inside docker-compose the host is "postgres"; locally use "localhost".
POSTGRES_USER=control
POSTGRES_PASSWORD=control
POSTGRES_DB=control_plane
DATABASE_URL=postgresql+asyncpg://control:control@postgres:5432/control_plane

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT (short-lived, device-bound session tokens) ──────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_super_secret_signing_key
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=900            # 15 minutes

# Server-side recompute cache for entitlements (seconds)
ENTITLEMENT_CACHE_TTL=60

# Anti-replay window for signed protected requests (seconds)
REQUEST_SIGNATURE_MAX_SKEW=30

# ─── Device / concurrency policy defaults (plans can override) ───────────────
DEVICE_REGISTER_COOLDOWN_HOURS=24

# ─── Telegram bot ────────────────────────────────────────────────────────────
BOT_TOKEN=123456:CHANGE_ME
# Comma-separated Telegram user IDs allowed to run admin commands
ADMIN_IDS=

# ─── Payments: Crypto Pay (@CryptoBot) ───────────────────────────────────────
CRYPTOPAY_API_TOKEN=CHANGE_ME
CRYPTOPAY_API_BASE=https://pay.crypt.bot/api
# Used to verify the webhook HMAC signature (sha256 of the API token per Crypto Pay spec)
CRYPTOPAY_WEBHOOK_ENABLED=true

# ─── Referral / rev-share ────────────────────────────────────────────────────
REFERRAL_RATE_STANDARD=0.20
REFERRAL_RATE_BLOGGER=0.30
# Reward only unlocks after the referred user's first paid invoice.
