# ─── App ────────────────────────────────────────────────────────────────────
ENV=local
LOG_LEVEL=INFO

# ─── Database (PostgreSQL, async driver) ──────────────────────────────────────
# Inside docker-compose the host is "postgres"; locally use "localhost".
POSTGRES_USER=control
POSTGRES_PASSWORD=control
POSTGRES_DB=control_plane
DATABASE_URL=postgresql+asyncpg://control:control@postgres:5432/control_plane

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── JWT (short-lived, device-bound session tokens) ──────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_super_secret_signing_key
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=900            # 15 minutes

# Server-side recompute cache for entitlements (seconds)
ENTITLEMENT_CACHE_TTL=60

# Anti-replay window for signed protected requests (seconds)
REQUEST_SIGNATURE_MAX_SKEW=30
# Require HMAC-signed (timestamp + nonce) protected requests
REQUEST_SIGNING_REQUIRED=true

# Impossible-travel threshold: sessions implying ground speed above this are flagged
IMPOSSIBLE_TRAVEL_MAX_KMH=1000

# ─── Device / concurrency policy defaults (plans can override) ───────────────
DEVICE_REGISTER_COOLDOWN_HOURS=24

# ─── Telegram bot ────────────────────────────────────────────────────────────
BOT_TOKEN=123456:CHANGE_ME
# Telegram user IDs allowed to run admin commands.
# One id (e.g. ADMIN_IDS=1966832731) or several comma-separated (ADMIN_IDS=111,222).
ADMIN_IDS=

# ─── Production hosting (VPS + HTTPS) ────────────────────────────────────────
# Public domain pointing at this server (A record). Caddy uses it to obtain a
# free HTTPS certificate automatically. Crypto Pay webhooks arrive at
# https://<DOMAIN>/webhooks/cryptopay . Leave blank for local-only (no HTTPS).
DOMAIN=

# ─── Payments: Crypto Pay (@CryptoBot) ───────────────────────────────────────
CRYPTOPAY_API_TOKEN=CHANGE_ME
CRYPTOPAY_API_BASE=https://pay.crypt.bot/api
# Used to verify the webhook HMAC signature (sha256 of the API token per Crypto Pay spec)
CRYPTOPAY_WEBHOOK_ENABLED=true

# ─── Referral / rev-share ────────────────────────────────────────────────────
REFERRAL_RATE_STANDARD=0.20
REFERRAL_RATE_BLOGGER=0.30
# Reward only unlocks after the referred user's first paid invoice.

# ─── Expiry reminders ────────────────────────────────────────────────────────
# DM users before their subscription lapses (localized). Comma-separated
# days-left bands; the worker sweeps every EXPIRY_REMINDER_MINUTES.
EXPIRY_REMINDERS_ENABLED=true
EXPIRY_REMINDER_DAYS=3,1
EXPIRY_REMINDER_MINUTES=60

# ─── AI support agent (free, OpenAI-compatible — default: Groq) ──────────────
# Get a FREE key (no credit card) at https://console.groq.com/keys .
# Leave SUPPORT_API_KEY as CHANGE_ME to disable the AI agent (the bot still
# works; free-text messages get a fallback reply).
SUPPORT_AI_ENABLED=true
SUPPORT_API_KEY=CHANGE_ME
SUPPORT_PROVIDER=groq
SUPPORT_MODEL=llama-3.3-70b-versatile
SUPPORT_BASE_URL=https://api.groq.com/openai/v1
SUPPORT_HISTORY_TURNS=10
# Other free/paid options (just change the 3 lines above), e.g.:
#   OpenAI:     SUPPORT_BASE_URL=https://api.openai.com/v1     SUPPORT_MODEL=gpt-4o-mini
#   OpenRouter: SUPPORT_BASE_URL=https://openrouter.ai/api/v1  SUPPORT_MODEL=...

# ─── Notion sync (optional advanced database / CRM dashboard) ────────────────
# Mirror your customers, subscriptions, payments, referrals and flags into a
# Notion workspace as linked databases (auto-created for you). To enable:
#   1. Create an integration at https://www.notion.so/my-integrations (copy the
#      "Internal Integration Secret" -> NOTION_API_KEY).
#   2. Make a blank Notion page, open "•••" -> Connections -> add your integration.
#   3. Copy that page's id from its URL (the 32-char hex after the title) into
#      NOTION_PARENT_PAGE_ID, and set NOTION_SYNC_ENABLED=true.
# Leave NOTION_API_KEY as CHANGE_ME (or NOTION_SYNC_ENABLED=false) to keep it off.
NOTION_SYNC_ENABLED=false
NOTION_API_KEY=CHANGE_ME
NOTION_PARENT_PAGE_ID=
NOTION_API_BASE=https://api.notion.com/v1
NOTION_VERSION=2022-06-28
NOTION_RECONCILE_MINUTES=3
# Two-way control: set the "Action" field on a Customer row in Notion
# (grant_monthly / grant_yearly / grant_trial / revoke / mark_blogger /
# unmark_blogger) and the bot applies it via the same secure path as admin
# commands. Set false to make Notion strictly read-only.
NOTION_ALLOW_ACTIONS=true
